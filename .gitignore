# ALLOWLIST: this repo is public. Everything is ignored unless listed below, so a new
# folder or a stray file (logs, worlds, jars, configs, screenshots, secrets) can't be
# committed by accident. To publish something new, add it here on purpose.
/*
!/.gitignore
!/README.md
!/family-tech/
!/family-server/

/family-*/*
!/family-*/README.md
!/family-*/MODS.md

# packwiz packs: .toml metadata (names, versions, download links; never jars) plus the
# small .json configs the pack ships (e.g. config/resourcepackoverrides.json).
!/family-*/pack/
/family-*/pack/**
!/family-*/pack/**/
!/family-*/pack/**/*.toml
!/family-*/pack/**/*.json

# Family Tech's server-side tuning: scripts and datapack JSON only.
!/family-tech/server/
/family-tech/server/**
!/family-tech/server/**/
!/family-tech/server/*.py
!/family-tech/server/kubejs/server_scripts/*.js
!/family-tech/server/kubejs/startup_scripts/*.js
!/family-tech/server/kubejs/config/*.json
!/family-tech/server/datapacks/**/*.json
!/family-tech/server/datapacks/**/*.mcmeta
